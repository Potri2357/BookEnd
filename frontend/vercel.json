{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://postern-bwiq.onrender.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://postern-bwiq.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
