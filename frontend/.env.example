# ==============================================================================
#  Postern Frontend — Environment Configuration Template (.env.example)
# ==============================================================================

# Local Vite development server port
VITE_PORT=5173

# Target backend URL used by the Vite development server proxy
VITE_BACKEND_URL=http://localhost:8008

# API Base URL:
# - Use `/v1` when deploying on the same origin, with Docker Compose, or through Nginx
# - For Split Cloud deployments (Vercel at https://postern-five.vercel.app -> Render at https://postern-bwiq.onrender.com):
VITE_API_BASE_URL=https://postern-bwiq.onrender.com/v1
