# ==============================================================================
#  BookEnd Enterprise Platform — Environment Configuration Template (.env.example)
# ==============================================================================
#  Copy this file to `.env` before starting the application or deploying.
#  All sensitive values should be kept secure and never committed to public git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER NETWORKING
# ------------------------------------------------------------------------------
# In cloud deployments (Render, Railway, Heroku), $PORT is automatically injected.
PORT=8008

# Bind to 0.0.0.0 so the application is reachable inside Docker, VMs, and Cloud containers
HOST=0.0.0.0

# Application branding and execution mode
APP_NAME=BookEnd
ENVIRONMENT=production
SIMULATED_BANNER=true

# ------------------------------------------------------------------------------
# 2. COLUMNAR DATA ENGINE & CRYPTOGRAPHIC LEDGER
# ------------------------------------------------------------------------------
# Path to the embedded columnar DuckDB database file
DATABASE_PATH=patchguard.duckdb

# Path to the append-only SHA-256 tamper-evident audit ledger file
AUDIT_LEDGER_PATH=audit_ledger.json

# ------------------------------------------------------------------------------
# 3. FORENSIC SLA TIMERS & REGULATORY CONSTRAINTS
# ------------------------------------------------------------------------------
# Default pre-disclosure lookback window in days (45 days per PRD spec)
DEFAULT_LOOKBACK_DAYS=45

# Minimum log retention threshold (85% required; below this forces 'Cannot verify')
COVERAGE_THRESHOLD=0.85

# Regulatory SLA countdown limits in hours
CERT_IN_EMERGENCY_HOURS=12
CERT_IN_HIGH_HOURS=24
CERT_IN_STANDARD_HOURS=72
CISA_TRIAGE_HOURS=72

# ------------------------------------------------------------------------------
# 4. FRONTEND BUILD & PROXY CONFIGURATION
# ------------------------------------------------------------------------------
# Local development server port
VITE_PORT=5173

# Target backend server URL used by the Vite development proxy
VITE_BACKEND_URL=http://localhost:8008

# API Base URL prefix used by the frontend client:
# - For Docker, Local, or Reverse Proxy deployments: use `/v1`
# - For Split Cloud deployments (Vercel + Render): use `https://<your-backend-url>/v1`
VITE_API_BASE_URL=/v1

# ------------------------------------------------------------------------------
# 5. AI INTELLIGENCE & FORENSIC ASSISTANT
# ------------------------------------------------------------------------------
# Provider Selection:
# - 'auto'          : Priority order -> Gemini (if key set) -> Local Ollama -> Local Deterministic Engine
# - 'gemini'        : Uses Google Gemini Cloud API
# - 'ollama'        : Uses 100% private, air-gapped local Ollama (zero data egress)
# - 'deterministic' : Built-in zero-dependency offline expert engine (no LLM required)
AI_PROVIDER=auto

# Optional Google Gemini Cloud API Key (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Air-Gapped Ollama Settings (Run `ollama run llama3` on your host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Maximum seconds to wait for an LLM response before falling back to local deterministic engine
AI_TIMEOUT_SECONDS=3.5
