# =====================================================================
# BookEnd (PatchGate) Enterprise Environment Configuration - Template
# =====================================================================

# Server Configuration
PORT=8008
HOST=0.0.0.0
APP_NAME=BookEnd
ENVIRONMENT=production
SIMULATED_BANNER=true

# Columnar Storage & Cryptographic Ledger
DATABASE_PATH=patchguard.duckdb
AUDIT_LEDGER_PATH=audit_ledger.json

# Forensic SLA & Threshold Constraints
DEFAULT_LOOKBACK_DAYS=45
COVERAGE_THRESHOLD=0.85
CERT_IN_EMERGENCY_HOURS=12
CERT_IN_HIGH_HOURS=24
CERT_IN_STANDARD_HOURS=72
CISA_TRIAGE_HOURS=72

# Frontend Network Binding & Proxies
VITE_PORT=5173
VITE_BACKEND_URL=http://localhost:8008
VITE_API_BASE_URL=/v1

# AI Intelligence Provider Settings
# Options for AI_PROVIDER: 'auto' (Gemini -> Ollama -> Deterministic), 'gemini', 'ollama', 'deterministic'
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
AI_TIMEOUT_SECONDS=3.5

